{
  "name": "trace-analyser",
  "version": "0.1.0",
  "description": "A local-first terminal browser for coding-agent traces",
  "keywords": [
    "cli",
    "terminal",
    "tui",
    "ai-agents",
    "traces",
    "sessions",
    "claude-code",
    "codex",
    "cursor",
    "hermes"
  ],
  "homepage": "https://theproductartist.com/projects/trace-analyser",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aayush962/trace-analyser.git"
  },
  "bugs": {
    "url": "https://github.com/aayush962/trace-analyser/issues"
  },
  "license": "MIT",
  "author": "Aayush Agarwal",
  "type": "module",
  "bin": {
    "trace-analyser": "dist/cli.js",
    "trace-reader": "dist/cli.js"
  },
  "files": [
    "dist",
    "schemas",
    "README.md"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "tsx src/cli.tsx",
    "build": "tsc",
    "start": "node dist/cli.js",
    "demo": "tsx src/cli.tsx demo",
    "schema:generate": "node --import tsx scripts/generate-schema.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "dependencies": {
    "commander": "15.0.0",
    "ink": "8.0.0",
    "react": "19.3.0",
    "string-width": "8.1.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
