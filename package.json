{
  "name": "trace-reader",
  "version": "0.1.0",
  "description": "A local-first terminal browser for agent traces",
  "type": "module",
  "bin": {
    "trace-reader": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "docs",
    "schemas"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "tsx src/cli.tsx",
    "build": "tsc",
    "start": "node dist/cli.js",
    "schema:generate": "node --import tsx scripts/generate-schema.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "prepack": "npm run build"
  },
  "dependencies": {
    "commander": "15.0.0",
    "ink": "8.0.0",
    "react": "19.3.0",
    "string-width": "8.1.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
